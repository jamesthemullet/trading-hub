{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "^18.18.0",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev",
    "codegen": "npm run copy && swagger-typescript-api --path https://prod-search-service-v1-eun-layer4-frontdoor.azurefd.net/search-merchandising.yml --output src/libs/api/generated --name open-api.ts --extract-response-body  --clean-output --another-array-type --sort-types --union-enums --extract-enums --enum-names-as-values --route-types",
    "copy": "copy-files-from-to",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tdd": "jest --watchAll --coverage",
    "test": "jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "dependencies": {
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@mantine/core": "7.12.2",
    "@mantine/dates": "7.12.2",
    "@mantine/hooks": "7.12.2",
    "date-fns": "3.6.0",
    "dayjs": "1.11.13",
    "lodash": "4.17.21",
    "next": "14.2.9",
    "next-auth": "4.24.7",
    "openapi-response-validator": "12.1.3",
    "pluralize": "8.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "yaml-loader": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-syntax-jsx": "7.24.7",
    "@babel/plugin-transform-react-jsx": "7.25.2",
    "@babel/plugin-transform-runtime": "7.25.4",
    "@babel/preset-env": "7.25.4",
    "@babel/preset-react": "7.24.7",
    "@babel/preset-typescript": "7.24.7",
    "@emotion/jest": "11.13.0",
    "@jest/globals": "29.7.0",
    "@next/eslint-plugin-next": "14.2.9",
    "@playwright/test": "1.47.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.17.7",
    "@types/node": "20.16.5",
    "@types/pluralize": "0.0.33",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@typescript-eslint/eslint-plugin": "8.5.0",
    "@typescript-eslint/parser": "8.5.0",
    "all-contributors-cli": "6.26.1",
    "babel-jest": "29.7.0",
    "copy-files-from-to": "3.11.0",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.9",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-functional": "6.6.3",
    "eslint-plugin-import": "2.30.0",
    "eslint-plugin-jest": "28.8.3",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-lodash": "7.4.0",
    "eslint-plugin-playwright": "1.6.2",
    "eslint-plugin-react": "7.35.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-testing-library": "6.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "2.2.2",
    "msw": "2.4.4",
    "node-fetch": "3.3.2",
    "openapi-types": "12.1.3",
    "postcss": "8.4.45",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.3.3",
    "swagger-typescript-api": "13.0.22",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.2"
  },
  "copyFiles": [
    {
      "from": "https://prod-search-service-v1-eun-layer4-frontdoor.azurefd.net/search-merchandising.yml",
      "to": "/src/libs/api/api.yml"
    }
  ],
  "copyFilesSettings": {
    "whenFileExists": "overwrite"
  }
}
