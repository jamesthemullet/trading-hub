{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "node": "24.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "pnpm run codegen && next dev --turbo",
    "dev:turbo-verbose": "pnpm run codegen && next dev --turbo --show-all",
    "codegen": "swagger-typescript-api generate --path src/libs/api/api.yml --output src/libs/api/generated/ --name open-api.ts --extract-response-body --extract-response-error --extract-enums --enum-style union",
    "build": "pnpm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix '**/*.css'",
    "tdd": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 pnpm exec jest --watchAll --coverage",
    "test": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 pnpm exec jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "pr-validate": "pnpm run codegen && pnpm run lint && pnpm run format:check && pnpm run ts-check && pnpm test --coverage --maxConcurrency=1 && pnpm exec playwright test --project=mock --workers=4",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test-storybook": "pnpm exec test-storybook",
    "knip": "knip",
    "bundle:analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@mantine/core": "9.7.1",
    "@mantine/dates": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@vercel/otel": "2.1.3",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "deepmerge": "4.3.1",
    "identity-obj-proxy": "3.0.0",
    "lodash": "4.18.1",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "pluralize": "8.0.0",
    "react": "19.3.0",
    "react-cookie": "8.1.2",
    "react-dom": "19.3.0",
    "tslib": "2.8.1",
    "xss": "1.0.15",
    "yaml-loader": "0.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@biomejs/js-api": "6.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.1",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "accented": "1.5.0",
    "all-contributors-cli": "6.26.1",
    "axe-core": "4.14.0",
    "concurrently": "10.0.5",
    "dotenv": "18.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-testing-library": "7.16.2",
    "http-server": "14.1.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-fail-on-console": "3.3.4",
    "jest-junit": "17.0.0",
    "jest-watch-typeahead": "3.0.1",
    "knip": "6.40.0",
    "msw": "2.15.0",
    "openapi-types": "12.1.3",
    "playwright": "1.64.0",
    "postcss": "8.5.29",
    "postcss-custom-media": "12.0.3",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.9",
    "storybook": "catalog:",
    "storybook-addon-deep-controls": "^0.10.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "swagger-typescript-api": "13.13.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "^8.0.0",
    "wait-on": "9.5.1"
  }
}
