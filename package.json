{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "20.19.6",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev --turbo",
    "dev:turbo-verbose": "npm run codegen && next dev --turbo --show-all",
    "codegen": "swagger-typescript-api generate --path src/libs/api/api.yml --output src/libs/api/generated/ --name open-api.ts --extract-response-body --extract-response-error --extract-enums --generate-union-enums",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix '**/*.css'",
    "tdd": "TZ=UTC node --max-old-space-size=4096 node_modules/.bin/jest --watchAll --coverage",
    "test": "TZ=UTC node --max-old-space-size=4096 node_modules/.bin/jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "pr-validate": "npm run codegen && npm run lint && npm run format:check && npm run ts-check && npm test --coverage --maxConcurrency=1 && npx playwright test --project=mock --workers=4",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test-storybook": "npx @storybook/test-runner",
    "knip": "knip"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.0",
    "@csstools/postcss-global-data": "3.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@emotion/is-prop-valid": "1.4.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mantine/core": "8.3.12",
    "@mantine/dates": "8.3.12",
    "@mantine/hooks": "8.3.12",
    "@storybook/addon-a11y": "10.1.11",
    "@vercel/otel": "2.1.0",
    "date-fns": "4.1.0",
    "dayjs": "1.11.19",
    "deepmerge": "4.3.1",
    "identity-obj-proxy": "3.0.0",
    "lodash": "4.17.21",
    "next": "16.1.1",
    "next-auth": "4.24.13",
    "openapi-response-validator": "12.1.3",
    "pluralize": "8.0.0",
    "react": "19.2.3",
    "react-cookie": "8.0.1",
    "react-dom": "19.2.3",
    "yaml-loader": "0.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@biomejs/js-api": "4.0.0",
    "@emotion/jest": "11.14.2",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@next/eslint-plugin-next": "16.1.1",
    "@playwright/test": "1.57.0",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/addon-onboarding": "10.1.11",
    "@storybook/addon-vitest": "10.1.11",
    "@storybook/nextjs-vite": "10.1.11",
    "@storybook/test-runner": "0.24.2",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.23",
    "@types/node": "22.19.5",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "accented": "1.2.2",
    "all-contributors-cli": "6.26.1",
    "concurrently": "9.2.1",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "9.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.12.1",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.4.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "10.1.11",
    "eslint-plugin-testing-library": "7.15.4",
    "http-server": "14.1.1",
    "jest": "30.2.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fail-on-console": "3.3.4",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "3.0.1",
    "knip": "5.80.2",
    "msw": "2.12.7",
    "node-fetch": "3.3.2",
    "openapi-types": "12.1.3",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "postcss-custom-media": "11.0.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.7.4",
    "storybook": "10.1.11",
    "storybook-addon-deep-controls": "^0.10.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-order": "7.0.1",
    "swagger-typescript-api": "13.2.16",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "typescript-plugin-css-modules": "5.2.0",
    "wait-on": "9.0.3"
  },
  "overrides": {
    "storybook": "$storybook",
    "nodemailer": "^7.0.7"
  }
}
