{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "20.19.2",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev",
    "codegen": "swagger-typescript-api generate --path src/libs/api/api.yml --output src/libs/api/generated/ --name open-api.ts --extract-response-body --extract-response-error --extract-enums --generate-union-enums",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "NODE_OPTIONS='-r newrelic' next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tdd": "TZ=UTC jest --watchAll --coverage",
    "test": "TZ=UTC jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "pr-validate": "npm run codegen && npm run lint && npm run format:check && npm run ts-check && npm test --coverage --maxConcurrency=1 && npx playwright test --project=mock --workers=4",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mantine/core": "8.1.1",
    "@mantine/dates": "8.1.1",
    "@mantine/hooks": "8.1.1",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "lodash": "4.17.21",
    "newrelic": "12.21.0",
    "next": "15.3.4",
    "next-auth": "4.24.11",
    "openapi-response-validator": "12.1.3",
    "pluralize": "8.0.0",
    "react": "19.1.0",
    "react-cookie": "8.0.1",
    "react-dom": "19.1.0",
    "winston": "3.17.0",
    "yaml-loader": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.27.4",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-syntax-jsx": "7.27.1",
    "@babel/plugin-transform-react-jsx": "7.27.1",
    "@babel/plugin-transform-runtime": "7.27.4",
    "@babel/preset-env": "7.27.2",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/js-api": "1.0.0",
    "@emotion/jest": "11.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.29.0",
    "@jest/globals": "29.7.0",
    "@next/eslint-plugin-next": "15.3.4",
    "@playwright/test": "1.53.1",
    "@storybook/addon-docs": "9.0.12",
    "@storybook/addon-onboarding": "9.0.12",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-vitest": "9.0.12",
    "@storybook/nextjs-vite": "9.0.12",
    "@swc/core": "1.12.4",
    "@swc/helpers": "0.5.17",
    "@swc/jest": "0.2.38",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.18",
    "@types/node": "22.15.32",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "all-contributors-cli": "6.26.1",
    "babel-jest": "29.7.0",
    "dotenv": "16.5.0",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-functional": "9.0.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-playwright": "2.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "9.0.12",
    "eslint-plugin-testing-library": "7.5.3",
    "jest": "30.0.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fail-on-console": "3.3.1",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "3.0.1",
    "msw": "2.10.2",
    "node-fetch": "3.3.2",
    "openapi-types": "12.1.3",
    "playwright": "1.53.1",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.5.3",
    "storybook": "9.0.12",
    "storybook-addon-deep-controls": "^0.9.3",
    "swagger-typescript-api": "13.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
