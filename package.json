{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "^18.17.0",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev",
    "codegen": "swagger-typescript-api --path src/libs/api/api.yml --output src/libs/api/generated --name open-api.ts --extract-response-body  --clean-output --another-array-type --sort-types --union-enums --extract-enums --enum-names-as-values --route-types",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.0",
    "@mantine/core": "7.6.2",
    "@mantine/dates": "7.6.2",
    "@mantine/hooks": "7.6.2",
    "dayjs": "1.11.10",
    "date-fns": "3.6.0",
    "next": "14.1.4",
    "next-auth": "4.24.7",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.3",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-syntax-jsx": "7.24.1",
    "@babel/plugin-transform-react-jsx": "7.23.4",
    "@babel/plugin-transform-runtime": "7.24.3",
    "@babel/preset-env": "7.24.3",
    "@babel/preset-react": "7.24.1",
    "@babel/preset-typescript": "7.24.1",
    "@emotion/jest": "11.11.0",
    "@jest/globals": "29.7.0",
    "@next/eslint-plugin-next": "14.1.4",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.2",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.30",
    "@types/react": "18.2.67",
    "@types/react-dom": "18.2.22",
    "babel-jest": "29.7.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.1.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-deprecation": "2.0.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-functional": "6.1.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-lodash": "7.4.0",
    "eslint-plugin-playwright": "1.5.4",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-simple-import-sort": "12.0.0",
    "eslint-plugin-testing-library": "6.2.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "2.2.2",
    "msw": "2.2.10",
    "node-fetch": "3.3.2",
    "postcss": "8.4.38",
    "postcss-preset-mantine": "1.13.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.2.5",
    "swagger-typescript-api": "13.0.3",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.4.3",
    "undici": "6.10.1"
  }
}
