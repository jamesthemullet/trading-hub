{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "node": "20.20.2",
    "pnpm": ">=10.28.2"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run codegen && next dev --turbo",
    "dev:turbo-verbose": "pnpm run codegen && next dev --turbo --show-all",
    "codegen": "swagger-typescript-api generate --path src/libs/api/api.yml --output src/libs/api/generated/ --name open-api.ts --extract-response-body --extract-response-error --extract-enums --generate-union-enums",
    "build": "pnpm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix '**/*.css'",
    "tdd": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 pnpm exec jest --watchAll --coverage",
    "test": "TZ=UTC NODE_OPTIONS=--max-old-space-size=4096 pnpm exec jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "pr-validate": "pnpm run codegen && pnpm run lint && pnpm run format:check && pnpm run ts-check && pnpm test --coverage --maxConcurrency=1 && pnpm exec playwright test --project=mock --workers=4",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test-storybook": "pnpm exec test-storybook",
    "knip": "knip",
    "bundle:analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@mantine/core": "9.0.1",
    "@mantine/dates": "9.0.1",
    "@mantine/hooks": "9.0.1",
    "@storybook/addon-a11y": "10.3.5",
    "@vercel/otel": "2.1.1",
    "date-fns": "4.1.0",
    "dayjs": "1.11.20",
    "deepmerge": "4.3.1",
    "identity-obj-proxy": "3.0.0",
    "lodash": "4.18.1",
    "next": "16.2.2",
    "next-auth": "4.24.13",
    "pluralize": "8.0.0",
    "react": "19.2.4",
    "react-cookie": "8.1.0",
    "react-dom": "19.2.4",
    "tslib": "2.8.1",
    "xss": "1.0.15",
    "yaml-loader": "0.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@biomejs/js-api": "4.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.2",
    "@playwright/test": "1.59.1",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-onboarding": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/nextjs-vite": "10.3.5",
    "@storybook/test-runner": "0.24.3",
    "@swc/core": "1.15.24",
    "@swc/helpers": "0.5.21",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/node": "22.19.17",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "accented": "1.2.5",
    "all-contributors-cli": "6.26.1",
    "concurrently": "9.2.1",
    "dotenv": "17.4.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "9.0.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.1",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.10.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "10.3.5",
    "eslint-plugin-testing-library": "7.16.2",
    "http-server": "14.1.1",
    "jest": "30.3.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fail-on-console": "3.3.4",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "3.0.1",
    "knip": "6.3.1",
    "msw": "2.12.14",
    "openapi-types": "12.1.3",
    "playwright": "1.59.1",
    "postcss": "8.5.9",
    "postcss-custom-media": "12.0.1",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.8.1",
    "storybook": "10.3.5",
    "storybook-addon-deep-controls": "^0.10.0",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "swagger-typescript-api": "13.6.7",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "^7.3.2",
    "wait-on": "9.0.4"
  },
  "overrides": {
    "storybook": "$storybook",
    "nodemailer": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "defu": ">=6.1.5",
      "flatted": ">=3.4.0",
      "lodash": ">=4.17.23",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "rollup": ">=4.59.0",
      "immutable": ">=5.1.5",
      "vite": ">=7.3.2 <8"
    }
  }
}
