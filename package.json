{
  "name": "trading-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "^18.17.0",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev",
    "codegen": "swagger-typescript-api --path src/libs/api/api.yml --output src/libs/api/generated --name open-api.ts --extract-response-body  --clean-output --another-array-type --sort-types --union-enums --extract-enums --enum-names-as-values --route-types",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc --build --force --verbose tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "11.11.0",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@babel/core": "7.23.9",
    "@babel/plugin-transform-react-jsx": "7.23.4",
    "@babel/preset-env": "7.23.9",
    "@babel/preset-typescript": "7.23.3",
    "@next/eslint-plugin-next": "14.1.0",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-jest": "29.7.0",
    "eslint": "8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-functional": "^6.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-lodash": "^7.4.0",
    "eslint-plugin-playwright": "^0.22.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "^3.2",
    "swagger-typescript-api": "13.0.3",
    "ts-node": "10.9.2",
    "typescript": "^5"
  }
}
