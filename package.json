{
  "name": "trading-hub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "npm": ">=9.6.7",
    "yarn": "please-use-npm",
    "node": "^20.9.0",
    "pnpm": "please-use-npm"
  },
  "scripts": {
    "dev": "npm run codegen && next dev",
    "codegen": "swagger-typescript-api generate --path src/libs/api/api.yml --output src/libs/api/generated/ --name open-api.ts --extract-response-body --extract-response-error --extract-enums --generate-union-enums ",
    "build": "npm run codegen && next build && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "NODE_OPTIONS='-r newrelic' next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tdd": "TZ=UTC jest --watchAll --coverage",
    "test": "TZ=UTC jest",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc  --build --force --verbose tsconfig.json",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mantine/core": "7.17.3",
    "@mantine/dates": "7.17.3",
    "@mantine/hooks": "7.17.3",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "lodash": "4.17.21",
    "newrelic": "12.16.1",
    "next": "15.2.4",
    "next-auth": "4.24.11",
    "openapi-response-validator": "12.1.3",
    "pluralize": "8.0.0",
    "react": "19.1.0",
    "react-cookie": "7.2.2",
    "react-dom": "19.1.0",
    "winston": "3.17.0",
    "yaml-loader": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-syntax-jsx": "7.25.9",
    "@babel/plugin-transform-react-jsx": "7.25.9",
    "@babel/plugin-transform-runtime": "7.26.10",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.27.0",
    "@emotion/jest": "11.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.23.0",
    "@jest/globals": "29.7.0",
    "@next/eslint-plugin-next": "15.2.4",
    "@playwright/test": "1.51.1",
    "@swc/core": "1.11.15",
    "@swc/jest": "0.2.37",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.16",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "8.29.0",
    "@typescript-eslint/parser": "8.29.0",
    "all-contributors-cli": "6.26.1",
    "babel-jest": "29.7.0",
    "dotenv": "16.4.7",
    "eslint": "9.23.0",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-functional": "9.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-playwright": "2.2.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-testing-library": "7.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fail-on-console": "3.3.1",
    "jest-junit": "16.0.0",
    "jest-watch-typeahead": "2.2.2",
    "msw": "2.7.3",
    "node-fetch": "3.3.2",
    "openapi-types": "12.1.3",
    "postcss": "8.5.3",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.5.3",
    "swagger-typescript-api": "13.0.28",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0"
  }
}
