{
  "extends": ["config:recommended"],
  "assigneesFromCodeOwners": true,
  "schedule": ["after 5pm every weekday", "before 9am every weekday"],
  "prConcurrentLimit": 3,
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": {
    "enabled": true
  },
  "recreateWhen": "never",
  "ignoreDeps": ["node"],
  "packageRules": [
    {
      "groupName": "mantine",
      "matchPackageNames": ["/mantine/"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "labels": ["dependencies"],
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major", "breaking"],
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["/react/"]
    }
  ]
}
