{
  "extends": ["config:recommended"],
  "assigneesFromCodeOwners": true,
  "schedule": ["after 5pm every weekday", "before 9am every weekday"],
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose"],
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 2,
  "dependencyDashboard": false,
  "toolSettings": {
    "nodeMaxMemory": 1024
  },
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": {
    "enabled": false
  },
  "recreateWhen": "never",
  "ignoreDeps": ["node"],
  "packageRules": [
    {
      "description": "Temporarily prevent pnpm package-manager updates while Renovate is memory constrained",
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "enabled": false
    },
    {
      "description": "Skip npm artifact generation for major updates while Renovate is hitting the memory limit",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "skipArtifactsUpdate": true
    },
    {
      "groupName": "mantine",
      "matchPackageNames": ["/mantine/"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "labels": ["dependencies"],
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major", "breaking"],
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["/react/"]
    }
  ]
}
